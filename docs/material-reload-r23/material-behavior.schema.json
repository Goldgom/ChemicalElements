{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChemicalElements material behavior classification v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "composition_kind", "all_species", "tags", "phase_model", "basis", "source", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9/._-]+$"},
    "composition_kind": {"enum": ["ANY", "PURE", "MIXTURE"]},
    "all_species": {"type": "array", "maxItems": 16384, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9/._-]+$"}},
    "tags": {"type": "array", "minItems": 1, "maxItems": 16384, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9/._-]+$"}},
    "phase_model": {"type": ["string", "null"], "pattern": "^[a-z0-9_.-]+:[a-z0-9/._-]+$"},
    "basis": {"const": "GAME_CONVENTION"},
    "source": {"type": "string", "minLength": 1, "maxLength": 4096},
    "limitations": {"type": "string", "minLength": 1, "maxLength": 4096}
  }
}
