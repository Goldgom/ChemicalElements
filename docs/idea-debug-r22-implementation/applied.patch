+// Explicit before-launch entry: no check/build/GameTest/jar prerequisite.
+def prepareIdeaClient = tasks.register('prepareIdeaClient') {
+    group = 'mod development'
+    description = 'Compile current sources/resources and prepare client launch files; no JAR or tests.'
+    dependsOn tasks.named('classes'), tasks.named('prepareClientRun')
+}
+// ModDev regenerates its Client configuration on IDEA sync. Keep its prerequisite too.
+// Do not attach this to prepareClientRun itself: that would create a dependency cycle.
+neoForge.runs.named('client') {
+    taskBefore prepareIdeaClient
+}
