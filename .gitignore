# MacOS DS_Store files
.DS_Store

# Gradle cache folder
.gradle

# Gradle build folder
build

# IntelliJ
out/
.idea
*.iml
# mpeltonen/sbt-idea plugin
.idea_modules/

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

# Common working directory
run

# Local runtime output and diagnostics
/logs/
*.log
*.jfr
replay_pid*

# Generated editor and tooling state (shared IDEA configurations live in .run/)
/.vscode/
/.github/modernize/
/bin/
/repo/

# Python caches
__pycache__/
*.py[cod]

# Local environment overrides
.env
.env.*
!.env.example
